      <column caption='HQ VS Branch' datatype='string' name='[Calculation_0642673783291907]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [City] = &quot;Mumbai&quot; THEN &quot;HQ&quot;&#13;&#10;            ELSE &quot;Branch&quot;&#13;&#10;END' />
