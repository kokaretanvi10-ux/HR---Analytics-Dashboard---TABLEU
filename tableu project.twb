  <worksheets>
    <worksheet name='Age Group Distribution'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Californian FB'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='HR_Dataset_India+' name='federated.1awevdw1mbo73x1ctznx31uuh1aj' />
          </datasources>
          <datasource-dependencies datasource='federated.1awevdw1mbo73x1ctznx31uuh1aj'>
            <column datatype='date' name='[Birth Date]' role='dimension' type='ordinal' />
            <column caption='Age' datatype='integer' name='[Calculation_0642673790144516]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;year&apos;, [Birth Date], TODAY())' />
